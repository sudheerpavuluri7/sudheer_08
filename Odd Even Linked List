-->Odd Even Linked List
package com.basics;

import java.util.Scanner;

// Node class for creating linked list
class Node {
    int val;
    Node next;

    public Node(int data) {
        this.val = data;
    }
}

public class Main {

    // Arrange odd-position nodes followed by even-position nodes
    public static Node oddEvenList(Node head) {

        // Dummy node for odd-position nodes
        Node oddDummy = new Node(0);

        // Dummy node for even-position nodes
        Node evenDummy = new Node(0);

        // Pointers to build odd and even lists
        Node oddCurr = oddDummy;
        Node evenCurr = evenDummy;

        // Traverse the original linked list
        Node curr = head;

        // Position starts from 1
        int index = 1;

        while (curr != null) {

            // If position is even
            if (index % 2 == 0) {

                // Add node to even list
                evenCurr.next = new Node(curr.val);
                evenCurr = evenCurr.next;

            } else {

                // Add node to odd list
                oddCurr.next = new Node(curr.val);
                oddCurr = oddCurr.next;
            }

            // Move to next node
            curr = curr.next;
            index++;
        }

        // Connect odd list with even list
        oddCurr.next = evenDummy.next;

        // Return the result
        return oddDummy.next;
    }

    // Print the linked list
    public static void printLL(Node head) {

        Node curr = head;

        while (curr != null) {
            System.out.print(curr.val + " ");
            curr = curr.next;
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        Node head = null;
        Node curr = null;

        // Read length of linked list
        int length = sc.nextInt();

        // Create linked list
        while (length > 0) {

            int val = sc.nextInt();

            if (head == null) {
                head = new Node(val);
                curr = head;
            } else {
                curr.next = new Node(val);
                curr = curr.next;
            }

            length--;
        }

        // Arrange odd-position nodes followed by even-position nodes
        head = oddEvenList(head);

        // Print result
        printLL(head);
    }
}
