package com.basics;

import java.util.Scanner;
import java.util.Stack;

// Node class for creating linked list
class Node {
    int val;
    Node next;

    public Node(int data) {
        this.val = data;
    }
}

public class Main {

    // Reverse the linked list using Stack
    public static Node reverseList(Node head) {

        // Create a pointer to traverse the linked list
        Node curr = head;

        // Create a Stack to store node values
        Stack<Integer> stack = new Stack<Integer>();

        // Store all node values in the Stack
        while (curr != null) {
            stack.push(curr.val);
            curr = curr.next;
        }

        // Dummy node to create the reversed list
        Node dummy = new Node(0);

        // Pointer to build the reversed list
        Node temp = dummy;

        // Take values from Stack and create the reversed list
        while (!stack.isEmpty()) {
            temp.next = new Node(stack.pop());
            temp = temp.next;
        }

        // Return the reversed linked list
        return dummy.next;
    }

    // Print the linked list
    public static void printLL(Node head) {

        Node curr = head;

        while (curr != null) {
            System.out.print(curr.val + " ");
            curr = curr.next;
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        Node head = null;
        Node curr = null;

        // Read length of linked list
        int length = sc.nextInt();

        // Create linked list
        while (length > 0) {

            int val = sc.nextInt();

            if (head == null) {
                head = new Node(val);
                curr = head;
            } else {
                curr.next = new Node(val);
                curr = curr.next;
            }

            length--;
        }

        // Reverse the linked list
        head = reverseList(head);

        // Print the reversed list
        printLL(head);
    }
}
