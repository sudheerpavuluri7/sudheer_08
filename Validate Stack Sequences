import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] pushed = new int[n];

        for (int i = 0; i < n; i++) {
            pushed[i] = sc.nextInt();
        }

        int m = sc.nextInt();
        int[] popped = new int[m];

        for (int i = 0; i < m; i++) {
            popped[i] = sc.nextInt();
        }

        Stack<Integer> stack = new Stack<Integer>();

        int j = 0;

        for (int i = 0; i < pushed.length; i++) {

            stack.push(pushed[i]);

            while (!stack.isEmpty() && j < popped.length &&
                   stack.peek() == popped[j]) {

                stack.pop();
                j++;
            }
        }

        if (stack.isEmpty()) {
            System.out.println(true);
        } else {
            System.out.println(false);
        }
    }
}
