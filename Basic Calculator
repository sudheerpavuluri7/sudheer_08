class Solution {
    public int calculate(String s) {
        int curr = 0;
    	int res = 0;
    	int sign = 1;
    	Stack<Integer> stack = new Stack<Integer>();
    	for(int i=0; i<s.length(); i++) {
    		char ch = s.charAt(i);
    		if(ch >= '0' && ch <= '9') {
    			curr = curr * 10 + ch - '0';
    		}
    		else if(ch == '+') {
    			res = res + curr * sign;
    			sign = 1;
    			curr = 0;
    		}else if(ch == '-') {
    			res = res + curr * sign;
    			sign = -1;
    			curr = 0;
    		}else if(ch == '(') {
    			stack.push(res);
    			stack.push(sign);
    			res = 0;
    			sign = 1;
    			
    		}else if(ch == ')') {
    			res = res + curr * sign;
    			int prevSign = stack.pop();
    			int prevRes = stack.pop();
    			res = prevRes + prevSign * res;
    			curr = 0;
    			sign = 1;
    		}
    	}
    	res = res + curr * sign;
        return res;
    }
}
