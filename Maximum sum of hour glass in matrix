-->Maximum sum of hour glass in matrix

import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Read number of rows
        int m = sc.nextInt();

        // Read number of columns
        int n = sc.nextInt();

        // Create the matrix
        int[][] grid = new int[m][n];

        // Read matrix elements
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                grid[i][j] = sc.nextInt();
            }
        }

        // Store the maximum hourglass sum
        int max = Integer.MIN_VALUE;

        // Move through each possible hourglass
        for (int i = 0; i <= m - 3; i++) {

            for (int j = 0; j <= n - 3; j++) {

                int sum = 0;

                // Add top three elements
                sum += grid[i][j];
                sum += grid[i][j + 1];
                sum += grid[i][j + 2];

                // Add middle element
                sum += grid[i + 1][j + 1];

                // Add bottom three elements
                sum += grid[i + 2][j];
                sum += grid[i + 2][j + 1];
                sum += grid[i + 2][j + 2];

                // Update maximum sum
                if (sum > max) {
                    max = sum;
                }
            }
        }

        // Print maximum hourglass sum
        System.out.println(max);
    }
}
