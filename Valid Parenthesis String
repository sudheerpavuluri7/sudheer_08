class Solution {
    public boolean checkValidString(String s) {
        int count = 0;
        for(int i=0; i<s.length(); i++){
            char ch = s.charAt(i);
            if(s.charAt(i) == ')'){
                count--;
                if(count < 0){
                    return false;
                }
            }else{
                count++;
            }
        }
        if(count < 0){
            return false;
        }
        count = 0;
        for(int i=s.length()-1; i>=0; i--){
            char ch = s.charAt(i);
            if(s.charAt(i) == '('){
                count--;
                if(count < 0){
                    return false;
                }
            }else{
                count++;
            }
        }
        if(count < 0){
            return false;
        }
        return true;
    }
}
