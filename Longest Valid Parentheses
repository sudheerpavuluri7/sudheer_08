class Solution {
    public int longestValidParentheses(String s) {
        int left = 0;
    	int right = 0;
    	int max = 0;
    	for(int i=0; i<s.length(); i++) {
    		char ch = s.charAt(i);
    		if(ch == '(') {
    			left++;
    		}else if(ch == ')') {
    			right++;
    		}
    		if(left == right) {
    			int size = left * 2;
    			if(size > max) {
    				max = size;
    			}
    		}
    		if(right > left) {
    			left = 0;
    			right = 0;
    		}
    	}
    	left = 0;
    	right = 0;
    	for(int i=s.length()-1; i>=0; i--) {
    		char ch = s.charAt(i);
    		if(ch == '(') {
    			left++;
    		}else if(ch == ')') {
    			right++;
    		}
    		if(left == right) {
    			int size = left * 2;
    			if(size > max) {
    				max = size;
    			}
    		}
    		if(left > right) {
    			left = 0;
    			right = 0;
    		}
    	}
        return max;
        
    }
}
