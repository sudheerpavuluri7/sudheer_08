package com.basics;

import java.util.Stack;

public class Main {
    public static void main(String args[]) {
    	
    	String s = "(((leet)";
    	
    	char[] ar = s.toCharArray();
    	
    	Stack<Integer> stack = new Stack<Integer>();
    	
    	for(int i=0; i<ar.length; i++) {
    		char ch = ar[i];
    		if(ch == '(') {
    			stack.push(i);
    		}else {
    			if(stack.isEmpty()) {
    				ar[i] = '$';
    			}else if(ch == ')'){
    				stack.pop();
    			}
    		}
    	}
    	while(!stack.isEmpty()) {
    		int index = stack.pop();
    		ar[index] = '$';
    	}
    	String res = "";
    	for(int i=0; i<ar.length; i++) {
    		if(ar[i] != '$') {
    			res = res + ar[i];
    		}
    	}
    	System.out.println(res);
    }
}
