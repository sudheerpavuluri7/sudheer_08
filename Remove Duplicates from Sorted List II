-->Remove Duplicates from Sorted List II
package com.basics;

import java.util.Scanner;

// Node class for creating linked list
class Node {
    int val;
    Node next;

    public Node(int data) {
        this.val = data;
    }
}

public class Main {

    // Remove all duplicate values from the sorted linked list
    public static Node deleteDuplicates(Node head) {

        // Create dummy node before head
        Node dummy = new Node(0);
        dummy.next = head;

        // prev points to the last node that is not duplicate
        Node prev = dummy;

        // curr is used to traverse the linked list
        Node curr = head;

        while (curr != null) {

            // Check whether current node is part of a duplicate group
            if (curr.next != null && curr.val == curr.next.val) {

                // Move curr to the last node of the duplicate group
                while (curr.next != null && curr.val == curr.next.val) {
                    curr = curr.next;
                }

                // Remove the entire duplicate group
                prev.next = curr.next;

            } else {

                // Current node is not duplicate, so move prev forward
                prev = prev.next;
            }

            // Move curr to the next node
            curr = curr.next;
        }

        // Return the actual head of the result list
        return dummy.next;
    }

    // Print the linked list
    public static void printLL(Node head) {

        Node curr = head;

        while (curr != null) {
            System.out.print(curr.val + " ");
            curr = curr.next;
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Create the linked list
        Node head = null;
        Node curr = null;

        // Read values until -1 is entered
        while (true) {

            int val = sc.nextInt();

            // -1 indicates the end of input
            if (val == -1) {
                break;
            }

            // Create the first node
            if (head == null) {
                head = new Node(val);
                curr = head;
            } else {

                // Add new node to the end of the list
                curr.next = new Node(val);
                curr = curr.next;
            }
        }

        // Remove duplicate values
        head = deleteDuplicates(head);

        // Print the result
        printLL(head);
    }
}
