-->Max product subarray

import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Read the size of the array
        int n = sc.nextInt();

        // Create the array
        int[] ar = new int[n];

        // Read array elements
        for (int i = 0; i < n; i++) {
            ar[i] = sc.nextInt();
        }

        // Store the maximum product
        int max = Integer.MIN_VALUE;

        // Product from left to right
        int leftProd = 1;

        for (int i = 0; i < ar.length; i++) {

            // Multiply current element
            leftProd = leftProd * ar[i];

            // Update maximum product
            if (leftProd > max) {
                max = leftProd;
            }

            // Reset product after zero
            if (leftProd == 0) {
                leftProd = 1;
            }
        }

        // Product from right to left
        int rightProd = 1;

        for (int i = ar.length - 1; i >= 0; i--) {

            // Multiply current element
            rightProd = rightProd * ar[i];

            // Update maximum product
            if (rightProd > max) {
                max = rightProd;
            }

            // Reset product after zero
            if (rightProd == 0) {
                rightProd = 1;
            }
        }

        // Print the maximum product
        System.out.println(max);
    }
}
